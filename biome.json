{
  "files": {
    "includes": [
      "**",
      "!tent.d.ts",
      "!walk/pictures",
      "!!.tent",
      "!!results",
      "!!node_modules",
      "!!desktop/target",
      "!!desktop/gen",
      "!!.archify",
      "!!build",
      "!!data",
      "!docs/architecture.html"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyInterface": "off",
        "noExplicitAny": "error",
        "noShadowRestrictedNames": "off",
        "noThenProperty": "off"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  }
}
